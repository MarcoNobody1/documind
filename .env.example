# Copy this file to `.env` before the first `docker compose up -d`:
#
#     cp .env.example .env
#
# `.env` is untracked. These three values configure the local pgvector container
# and nothing else. It is a throwaway database bound to localhost, so the
# password below is deliberately not a secret — it exists so that no credential
# literal has to live in tracked configuration. Never reuse these values in a
# shared or hosted environment.

POSTGRES_USER=documind
POSTGRES_PASSWORD=documind_dev
POSTGRES_DB=documind

# -----------------------------------------------------------------------------
# The API does not read this file.
#
# .NET has no built-in .env support, so the API gets its connection string from
# user-secrets instead. That string must agree with the three values above, or
# the container will come up fine and the API will fail to authenticate against
# it — a confusing failure, because each half looks correct on its own.
#
# Run this from backend/src/DocuMind.Api, using the SAME user, password and
# database as above:
#
#     dotnet user-secrets set "ConnectionStrings:Postgres" "Host=localhost;Port=5432;Database=documind;Username=documind;Password=documind_dev"
#
# If you change a value above, change it in both places.
# -----------------------------------------------------------------------------
