    <UserSecretsId>3629f7a4-34a1-4295-b5a1-39b6bafde7fd</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
