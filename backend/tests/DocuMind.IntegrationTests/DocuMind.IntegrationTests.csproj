<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by AccountIdentityBehaviourTests: SignInManager, IdentityConstants,
         AddAuthentication and IHttpContextAccessor live in the ASP.NET Core shared framework, not
         in the Identity packages Infrastructure already brings in transitively (those supply
         UserManager and the EF stores only). A FrameworkReference rather than a ProjectReference to
         DocuMind.Api: the tests need those framework types, not the application's composition root,
         and pulling the whole app in would make it far too easy to start testing through it by
         accident. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DocuMind.Application\DocuMind.Application.csproj" />
    <ProjectReference Include="..\..\src\DocuMind.Domain\DocuMind.Domain.csproj" />
    <ProjectReference Include="..\..\src\DocuMind.Infrastructure\DocuMind.Infrastructure.csproj" />
  </ItemGroup>

</Project>
