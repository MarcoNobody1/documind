<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Restrict restore to the public nuget.org feed only.
         Clear any inherited sources (e.g. the private nuget.zimaltec.es feed)
         so a fresh clone restores without access to internal infrastructure. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
